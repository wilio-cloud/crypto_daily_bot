# ==========================================
# OKX API Credentials
# ==========================================
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here

# Mode Demo / Simulació: posa 'true' per fer proves a Paper Trading d'OKX, 'false' per diners reals
OKX_IS_DEMO=true

# Nom del subcompte (opcional, només si utilitzes credencials de compte principal que gestiona subcomptes)
OKX_SUBACCOUNT_NAME=

# ==========================================
# Paràmetres d'Estratègia i Risc
# ==========================================
# Tipus d'instrument: 'SWAP' (Futurs Perpètus USDT) o 'SPOT' (Comptat)
INSTRUMENT_TYPE=SWAP

# Màxim de posicions simultànies (pla per a 11 cryptos)
MAX_OPEN_POSITIONS=11

# Divisió de capital: divideix el capital total entre 11 slots
CAPITAL_SLOTS=11

# Apalancament per a SWAP (1 per equivalent a spot, 2, 3, etc.)
LEVERAGE=2

# Mode de marge per a SWAP: 'isolated' (aïllat) o 'cross' (creuat)
MARGIN_MODE=isolated

# Capital de referència si la lectura d'API retorna 0
FALLBACK_EQUITY_USDT=1000.0

# Percentatge mínim de marge de seguretat lliure que mai s'ha de consumir (ex: 5%)
SAFETY_RESERVE_PCT=5.0

# ==========================================
# Seguretat Webhook
# ==========================================
# Paraula clau secreta que s'enviarà des de TradingView per autenticar la petició
WEBHOOK_SECRET=canvia_aquest_secret_per_un_token_segur

# ==========================================
# Notificacions Telegram (Opcional)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# Configuració Servidor
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
